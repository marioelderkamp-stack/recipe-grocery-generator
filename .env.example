VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
# Shared secret required by RLS to allow writes (insert/update/delete) on every
# table. Reads stay open to anyone with the anon key; writes are rejected by
# Postgres unless this exact value is sent as the x-household-secret header.
# Get the real value from whoever manages the Supabase project.
VITE_HOUSEHOLD_SECRET=your-household-write-secret
